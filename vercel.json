{
  "version": 2,
  "routes": [
    { "src": "/api/state",  "dest": "/api/state.js"  },
    { "src": "/api/auth",   "dest": "/api/auth.js"   },
    { "src": "/api/reset",  "dest": "/api/reset.js"  },
    { "src": "/api/info",   "dest": "/api/info.js"   },
    { "src": "/(.*)",       "dest": "/$1"             }
  ]
}
